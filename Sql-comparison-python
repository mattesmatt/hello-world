def get_sql():
    # -- The parameters for the script. Server, database and driver wont change
    conn_str = (
    f'DRIVER={DB_CONFIG["driver"]};'
    f'SERVER={DB_CONFIG["server"]};'
    f'DATABASE={DB_CONFIG["database"]};'
    'Trusted_Connection=yes;'
    'TrustServerCertificate=yes;'
    )

    query="""SELECT c.companycode,r.RoleName,m.ModuleName,replace(ep.PermissionName,',','-') as "PermissionName",eu.UserName,EmailID
FROM Atlascore..EMTRolePermission rp (nolock)
JOIN Atlascore..EMTRole r (nolock) ON rp.EMTRoleId = r.EMTRoleId
join Atlascore..EMTPermission (nolock) ep on ep.EMTPermissionId=rp.EMTPermissionId
JOIN Atlascore..EMTModule m (nolock) ON ep.EMTModuleId = m.EMTModuleId
JOIN Atlascore..EMTUserRole (nolock) eur on eur.EMTRoleId=r.EMTRoleId
join Atlascore..EMTUser eu (nolock) on eur.EMTUserId=eu.EMTUserId
JOIN Atlascore..EMTRoleCompany (nolock) cr on cr.EMTRoleId = r.EMTRoleId
JOIN Atlascore..Company c (nolock) on c.CompanyID = cr.CompanyId
WHERE eu.Status = 'E'
and r.RoleName not in ('Admin2','Admin3','Admin','Support')
and isADEnabled=1
ORDER BY username,2,3,4,1"""

    try:
        conn=pyodbc.connect(conn_str)
        sql_df=pd.read_sql(query,conn)
        conn.close()
        return sql_df
    except Exception as e:
        print(f"An error occurred while getting TEST data: {e}")
        return None

