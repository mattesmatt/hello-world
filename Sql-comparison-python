def send_email(updated_control_list,team,ticket,recipient_string):
    #Save the CSV file to XLSX in order to compress the size for the SDP
    target_folder=r"C:\Temp\Sql"
    if not os.path.exists(target_folder):
        os.makedirs(target_folder)
    print("Converting the CSV to excel by saving to temp directory for the email. . .")
    temp_xlsx = os.path.join(target_folder,f"List-{ticket}.xlsx")

    #convert to xlsx
    updated_control_list.to_excel(temp_xlsx,index=False,engine='openpyxl')

    #Change the team name for IS only and leave the team name for everyone else on the email subject
    clean_team=team.lower().strip()
    if clean_team.lower()=="twam2":
        display_name="ADMIN"
    else:
        display_name=team.upper()


    #Email step
    msg = EmailMessage()
    msg['Subject']=f"Re: [Request ID :##RE-{ticket}##] - {display_name} - Sandbox Control List"
    msg['From']="app_supp_hazeltree@hedgeserv.com"
    msg['To']=recipient_string
    msg.set_content(f"Hi {display_name},\n\nPlease find the updated control list for Ticket {ticket}. Ready for task 3.\n\nThanks,\nApp Support")

    print(f"Attempting to send to: {msg['To']}")

    try:
        if not os.path.exists(control_list):
            print(f"ERROR: attachment not found at {control_list}")
            return

        #Add the converted XLSX
        with open(temp_xlsx,'rb') as f:
            file_data=f.read()
            msg.add_attachment(file_data,maintype='application',subtype='vnd.openxmlformats-officedocument.spreadsheetml.sheet',filename=os.path.basename(temp_xlsx))

        #Send the email
        with smtplib.SMTP('mail.hedgeservcustomers.com',25) as server:
            server.starttls()
            #server.set_debuglevel(1)
            server.send_message(msg)
            print(f"Email sent to {recipient_string} with attachment ({os.path.getsize(temp_xlsx) / 1024:.1f} KB) sent.")

            #remove the temp file
            os.remove(temp_xlsx)
            print("Temp file deleted")

    except Exception as e:
        print(f"Email failed: {e}")



